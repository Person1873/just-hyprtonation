#!/usr/bin/env python3
"""Just hyprtonation: hypr-dwm-land tags as notes of a just-intonated scale, on a cello.

Reads hypr-dwm-land's line on Hyprland's event socket
    custom>>hyprdwmland>><monitor>|v=<viewed>|o=<tag:count,...>|u=<urgent>|f=<focused>
and plays: newly viewed tags (a chord when several arrive together), the populated tags as
an arpeggio when the view becomes "all", and an unresolved figure for an urgent tag that
resolves onto the tag's own note when the tag is viewed.

Backends: fluidsynth (a SoundFont cello, pitch-bent onto the just ratios) and dry (prints
what it would play; for tests).

    just-hyprtonation [--monitor NAME] [--instrument vibraphone|cello|glass|organ|saw|dulcimer|tubular|handbell]
                      (default: the last one picked, else vibraphone)
                      [--backend fluidsynth|dry] [--soundfont PATH] [--tonic MIDI] [--muted] [--stdin]
    just-hyprtonation mute | stop        signal the running instance (pidfile in XDG_RUNTIME_DIR)
    just-hyprtonation instrument NAME|next|prev | pick | status   change or show its instrument
    just-hyprtonation layout piano|laptop   F-key tuning, kept for next start
SIGUSR1 toggles mute. --stdin reads protocol lines from standard input instead of the socket.
"""
import argparse
import math
import os
import signal
import socket
import subprocess
import sys
import threading
import time

# ---------------------------------------------------------------------------------------
# Tuning. Tag 1 is the tonic. Digits are the white keys of a just major scale, an octave
# and a second; F-keys (tags 10..21) are the sharps, continuing upward. The sharps are a
# choice; they are the right one.
# ---------------------------------------------------------------------------------------

WHITE = [1, 9 / 8, 5 / 4, 4 / 3, 3 / 2, 5 / 3, 15 / 8, 2, 9 / 4]
BLACK = [25 / 24, 75 / 64, 45 / 32, 25 / 16, 225 / 128,
         25 / 12, 75 / 32, 45 / 16, 25 / 8, 225 / 64, 25 / 6, 75 / 16]


def white(i):
    """Degree i (1-based) of the major scale, continued through the octaves."""
    return WHITE[(i - 1) % 7] * 2 ** ((i - 1) // 7)


# Layouts for the F-keys. "piano": the twelve sharps in order. "laptop": the F-keys sit
# evenly above the digits, so F<n> is the key between white n and white n+1; where the
# piano has no black key there (E-F, B-C) the note completes the black keys' own major
# scale: F3 is the just major third above F1 and F7 the major seventh, so F1..F7 are a
# just major scale on the sharpened tonic.
def _laptop():
    return [BLACK_BY_GAP[(n - 1) % 7] * 2 ** ((n - 1) // 7) for n in range(1, 13)]


BLACK_BY_GAP = {0: 25 / 24, 1: 75 / 64, 2: 125 / 96, 3: 45 / 32, 4: 25 / 16, 5: 225 / 128, 6: 125 / 64}
LAYOUTS = {"piano": BLACK, "laptop": None}
RATIOS = {}


def set_layout(name):
    black = _laptop() if name == "laptop" else LAYOUTS[name]
    RATIOS.clear()
    RATIOS.update({i + 1: r for i, r in enumerate(WHITE)})
    RATIOS.update({10 + i: r for i, r in enumerate(black)})


set_layout("piano")


def degree_chord(tag):
    """The triad on a scale degree: stacked thirds of the scale for a white key, a major
    triad on the note for a black one."""
    if tag <= 9:
        return (white(tag), white(tag + 2), white(tag + 4))
    r = RATIOS[tag]
    return (r, r * 5 / 4, r * 3 / 2)

# The urgency figure, relative to the tag's own ratio r: the diminished seventh on the
# tag's leading tone (ti in the bass, re, fa, le above: 15/16, 9/8, 4/3, 8/5), held and
# left. Every voice is one step from the tag's major triad, which is the resolution.
# Two hits: a short one, then the held one, with the leading tone doubled an octave down.
URGENT_FIGURE = [
    ((15 / 32, 15 / 16, 9 / 8, 4 / 3, 8 / 5), 0.12),
    ((15 / 32, 15 / 16, 9 / 8, 4 / 3, 8 / 5), 0.5),
]
URGENT_VELOCITY = 127             # a bow strike, not a swell (the cello's; see STRIKE_VELOCITY)
STRIKE_VELOCITY = 80              # ceiling for other instruments, which hit harder than a cello
URGENT_RESOLVE = (1, 5 / 4, 3 / 2)
URGENT_REPEAT = 60.0              # seconds between reminders while ignored
BEND_RANGE = 2                    # semitones either way, set on every channel
# Instruments: General MIDI programs (zero-based) for the melodic channels and for the
# urgency strike, the tonic (MIDI note of tag 1), extra controllers, reverb settings, and
# `env`: timecent offsets added to the preset's volume-envelope attack and release
# (1200 per doubling), sent as SoundFont NRPNs. MIDI's sound controllers (CC 71..74) do
# nothing in fluidsynth with a SoundFont that defines no modulators for them, which
# FluidR3_GM does not; measured, see AUTHORSHIP.
INSTRUMENTS = {
    "cello":        dict(sustain=True, melodic=42, strike=42, tonic=48, strike_velocity=127),
    "glass":        dict(sustain=True, melodic=92, strike=98, tonic=72, velocity=56, strike_velocity=70),   # bowed glass / crystal, played softly
    "organ":        dict(sustain=True, melodic=19, strike=19, tonic=48),    # church organ
    "saw":          dict(sustain=True, melodic=81, strike=81, tonic=36, env=dict(attack=3600, release=3200)),   # softened on and off
    "vibraphone":   dict(melodic=11, strike=11, tonic=60, strike_velocity=104),
    "dulcimer":     dict(melodic=15, strike=15, tonic=60),
    "marimba":      dict(melodic=12, strike=12, tonic=60),
    "tubular":      dict(melodic=14, strike=14, tonic=60),   # tubular bells
    # town-crier handbells: the glockenspiel patch in a room, reverb send up
    "handbell":     dict(melodic=9,  strike=9,  tonic=72, cc=((91, 110),),
                         reverb=dict(roomsize=0.75, damp=0.3, width=0.8, level=0.9)),
}
STRIKE_LEVEL = ((7, 127), (11, 127))
DEFAULT_REVERB = dict(roomsize=0.2, damp=0.0, width=0.5, level=0.9)   # fluidsynth's own
# Reverb send back to fluidsynth's channel default before an instrument sets its own;
# "reset all controllers" (CC 121) leaves it alone by spec.
RESET_CC = ((91, 40),)
GEN_ATTACK, GEN_RELEASE = 34, 38   # SoundFont generator numbers (volume envelope)
MELODIC_CC = ((7, 96), (11, 118))             # headroom so the strike lands above the line
# One channel per simultaneous note (pitch bend is per channel). Channel 9 is General
# MIDI's percussion channel whatever program it is given, so it is never used. The cello
# and the strike patch live on separate channel pools.
MELODIC_CHANNELS = [0, 1, 2, 3, 4, 5, 6, 7, 8]
STRIKE_CHANNELS = [10, 11, 12, 13, 14, 15]
NOTE_LEN = 0.9
CHORD_LEN = 1.4
ARP_NOTE = 0.32        # short, so at most two arpeggio notes ring together
ARP_STEP = 0.17
FIGURE_GAP = 0.06
RESOLVE_LEN = 1.2
VELOCITY = 84


def midi_and_bend(tonic, ratio):
    """Nearest MIDI key and 14-bit pitch-bend value placing `ratio` above `tonic`."""
    semis = 12 * math.log2(ratio)
    key = int(round(tonic + semis))
    frac = tonic + semis - key            # semitones off the key, |frac| <= 0.5
    bend = int(round(8192 + frac / BEND_RANGE * 8192))
    return max(0, min(127, key)), max(0, min(16383, bend))


# ---------------------------------------------------------------------------------------
# Backends
# ---------------------------------------------------------------------------------------

class Dry:
    """Prints the commands it would send. Used by --backend dry and the tests."""

    def __init__(self, tonic, **_):
        self.tonic = tonic
        self.transpose = 0

    def set_instrument(self, name):
        print(f"instrument {name}", flush=True)

    sustain = True

    def play(self, ratio, seconds, velocity=VELOCITY, strike=False):
        key, bend = midi_and_bend(self.tonic + self.transpose, ratio)
        cents = 1200 * math.log2(ratio)
        length = "held" if seconds is None else f"for {seconds:.2f}s"
        print(f"play ratio={ratio:.5f} ({cents:7.1f} cents) key={key} bend={bend} "
              f"vel={velocity} {length}{' strike' if strike else ''}", flush=True)
        return (0, key)

    def release(self, handle):
        print(f"release key={handle[1]}", flush=True)

    def close(self):
        pass


class FluidSynth:
    """One fluidsynth process; commands over its stdin shell. Each simultaneous note gets
    its own channel because pitch bend is per channel."""

    def __init__(self, tonic, soundfont, audio_driver="pipewire", gain=0.8, instrument="vibraphone",
                 fixed_tonic=False, **_):
        self.tonic = tonic
        self.transpose = 0                  # semitones, from jam mode's +/-
        self.fixed_tonic = fixed_tonic      # --tonic given: keep it across instrument changes
        self.lock = threading.Lock()
        self.next_channel = 0
        self.next_strike = 0
        # -n: no MIDI input driver. No -i: the shell stays on and reads our commands from
        # stdin (fluidsynth creates it whenever it is not playing a MIDI file).
        # -z/-c: 64-frame periods, 4 of them (default 16): ~6 ms of buffering instead of ~23.
        cmd = ["/usr/bin/fluidsynth", "-n", "-a", audio_driver, "-q", "-g", str(gain),
               "-z", "64", "-c", "4", soundfont]
        self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, text=True)
        self.set_instrument(instrument)

    def set_instrument(self, name):
        """Program every channel for `name`; safe while notes are sounding (they finish on
        the old patch). Reverb goes back to fluidsynth's defaults unless the instrument
        sets its own."""
        inst = INSTRUMENTS[name]
        self.instrument = name
        self.velocity = inst.get("velocity", VELOCITY)
        self.strike_velocity = inst.get("strike_velocity", STRIKE_VELOCITY)
        if not self.fixed_tonic:
            self.tonic = inst["tonic"]
        self._send("reverb on")
        for k, v in dict(DEFAULT_REVERB, **inst.get("reverb", {})).items():
            self._send(f"rev_set{k} {v}")
        self.sustain = bool(inst.get("sustain"))
        env = self.env = inst.get("env", {})
        for ch in MELODIC_CHANNELS:
            self._send(f"prog {ch} {inst['melodic']}")
            self._send(f"pitch_bend_range {ch} {BEND_RANGE}")
            for cc, val in RESET_CC + MELODIC_CC + inst.get("cc", ()):
                self._send(f"cc {ch} {cc} {val}")
            self._envelope(ch, env)
        for ch in STRIKE_CHANNELS:
            self._send(f"prog {ch} {inst['strike']}")
            self._send(f"pitch_bend_range {ch} {BEND_RANGE}")
            for cc, val in RESET_CC + STRIKE_LEVEL + inst.get("cc", ()):
                self._send(f"cc {ch} {cc} {val}")
            self._envelope(ch, env)

    def _envelope(self, ch, env):
        """Volume-envelope attack and release offsets in timecents, as SoundFont NRPNs
        (NRPN MSB 120 selects generators; data entry is 8192 + offset/2, LSB first since
        the MSB commits). Zero offsets restore the preset's own values."""
        for gen, key in ((GEN_ATTACK, "attack"), (GEN_RELEASE, "release")):
            data = 8192 + max(-8192, min(8191, int(env.get(key, 0)) // 2))
            self._send(f"cc {ch} 99 120")
            self._send(f"cc {ch} 98 {gen}")
            self._send(f"cc {ch} 38 {data & 127}")
            self._send(f"cc {ch} 6 {data >> 7}")
        self._send(f"cc {ch} 99 127")
        self._send(f"cc {ch} 98 127")

    def _send(self, line):
        with self.lock:
            if self.proc.poll() is not None:
                return
            self.proc.stdin.write(line + "\n")
            self.proc.stdin.flush()

    def play(self, ratio, seconds, velocity=VELOCITY, strike=False):
        key, bend = midi_and_bend(self.tonic + self.transpose, ratio)
        with self.lock:
            if strike:
                ch = STRIKE_CHANNELS[self.next_strike]
                self.next_strike = (self.next_strike + 1) % len(STRIKE_CHANNELS)
            else:
                ch = MELODIC_CHANNELS[self.next_channel]
                self.next_channel = (self.next_channel + 1) % len(MELODIC_CHANNELS)
        self._send(f"pitch_bend {ch} {bend}")
        if strike:
            velocity = min(velocity, self.strike_velocity)
        elif velocity == VELOCITY:
            velocity = self.velocity
        if self.env.get("attack") and seconds is not None and seconds < NOTE_LEN:
            # scale the swell to the note: a short arpeggio note gets a short onset
            env = dict(self.env, attack=self.env["attack"] + 1200 * math.log2(seconds / NOTE_LEN))
            self._envelope(ch, env)
        elif self.env.get("attack"):
            self._envelope(ch, self.env)
        self._send(f"noteon {ch} {key} {int(velocity)}")
        if seconds is None:                 # held: the caller releases
            return (ch, key)
        threading.Timer(seconds, lambda: self._send(f"noteoff {ch} {key}")).start()

    def release(self, handle):
        ch, key = handle
        self._send(f"noteoff {ch} {key}")

    def close(self):
        self._send("reset")
        self._send("quit")
        try:
            self.proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            self.proc.kill()


# ---------------------------------------------------------------------------------------
# The music
# ---------------------------------------------------------------------------------------

class Player:
    def __init__(self, synth, ntags=21):
        self.synth = synth
        self.ntags = ntags
        self.muted = False
        self.viewed = set()
        self.occupied = set()
        self.urgent = set()
        self.urgent_timers = {}
        self.held = {}          # jam mode: (kind, tag) -> synth handles while a key is down
        self.lock = threading.Lock()

    def _play(self, ratio, seconds, velocity=VELOCITY, strike=False):
        if not self.muted:
            self.synth.play(ratio, seconds, velocity, strike)

    def _later(self, delay, fn):
        t = threading.Timer(delay, fn)
        t.daemon = True
        t.start()
        return t

    # -- events -------------------------------------------------------------------------

    def view_changed(self, new_view, occupied):
        added = new_view - self.viewed
        is_all = len(new_view) >= self.ntags
        was_all = len(self.viewed) >= self.ntags
        resolving = (new_view & self.urgent) - (self.viewed & self.urgent)
        if is_all and not was_all:
            self.arpeggio(sorted(occupied))
        elif not is_all and new_view != self.viewed:
            # the view you are now looking at, as a chord (one tag: one note)
            self.chord(sorted(new_view - resolving))
        # an urgent tag that just came into view resolves; its note is the resolution
        for k in sorted(resolving):
            self.resolve(k)
        self.viewed = set(new_view)

    def urgency_changed(self, new_urgent):
        for k in sorted(new_urgent - self.urgent):
            if k not in self.viewed:
                self.figure(k, first=True)
        for k in self.urgent - new_urgent:
            t = self.urgent_timers.pop(k, None)
            if t:
                t.cancel()
        self.urgent = set(new_urgent)

    # -- gestures -----------------------------------------------------------------------

    def chord(self, tags):
        length = CHORD_LEN if len(tags) > 1 else NOTE_LEN
        for k in tags:
            if k in RATIOS:
                self._play(RATIOS[k], length)

    def arpeggio(self, tags):
        tags = [k for k in tags if k in RATIOS]
        if not tags:
            return
        step = min(ARP_STEP, 1.5 / len(tags))
        for i, k in enumerate(tags):
            self._later(i * step, lambda r=RATIOS[k]: self._play(r, ARP_NOTE))

    def figure(self, k, first=False):
        """The diminished seventh on the tag's leading tone, held; it wants the tag's triad."""
        r = RATIOS.get(k)
        if r is None:
            return
        t = 0.0
        for notes, length in URGENT_FIGURE:
            for lean in notes:
                self._later(t, lambda rr=r * lean, ln=length: self._play(rr, ln, URGENT_VELOCITY, True))
            t += length + FIGURE_GAP
        # the reminder, while it stays urgent and unviewed
        t = self._later(URGENT_REPEAT, lambda: self._remind(k))
        old = self.urgent_timers.get(k)
        if old:
            old.cancel()
        self.urgent_timers[k] = t

    def _remind(self, k):
        with self.lock:
            if k in self.urgent and k not in self.viewed:
                self.figure(k)

    def resolve(self, k):
        r = RATIOS.get(k)
        if r is None:
            return
        t = self.urgent_timers.pop(k, None)
        if t:
            t.cancel()
        for lean in URGENT_RESOLVE:
            self._play(r * lean, RESOLVE_LEN)

    # -- protocol -----------------------------------------------------------------------

    HOLD_CAP = 12.0     # a held note is released anyway after this, in case a key-up was lost

    def _jam_ratios(self, what, tag):
        if what.startswith("degree"):
            return [white(tag)] if what == "degree" else [white(tag), white(tag + 2), white(tag + 4)]
        if tag not in RATIOS:
            return []
        return [RATIOS[tag]] if what == "note" else list(degree_chord(tag))

    def _hold(self, keyid, what, tag):
        """Key down: sustaining instruments hold until `_release`; others play their length.
        `keyid` is the physical key, so any release of that key frees what it started even
        if the modifiers changed in between."""
        ratios = self._jam_ratios(what, tag)
        length = CHORD_LEN if len(ratios) > 1 else NOTE_LEN
        if self.muted or not ratios:
            return
        if not self.synth.sustain:
            for r in ratios:
                self._play(r, length)
            return
        with self.lock:
            self._release_locked(keyid)
            handles = [self.synth.play(r, None) for r in ratios]
            self.held[keyid] = handles
        threading.Timer(self.HOLD_CAP, lambda: self._release(keyid, handles)).start()

    def _release(self, keyid, only=None):
        with self.lock:
            self._release_locked(keyid, only)

    def _release_locked(self, keyid, only=None):
        handles = self.held.get(keyid)
        if handles is None or (only is not None and handles is not only):
            return
        del self.held[keyid]
        for h in handles:
            self.synth.release(h)

    def _release_all(self):
        with self.lock:
            for keyid in list(self.held):
                self._release_locked(keyid)

    def jam(self, text):
        """Jam mode: `note|N` plays tag N's note, `chord|N` the triad on its scale degree,
        `degree|N` / `degreechord|N` the same for scale degree N (the 0 key is degree 10);
        `on|K|<kind>|N` / `off|K` are key down and key up on physical key K: a sustaining
        instrument holds the note in between, a struck one plays its length on the down;
        `alloff` releases everything.
        `transpose|S` moves the key by S semitones and sounds the new tonic. Nothing else
        changes; the keys are bound inside a Hyprland submap that shadows the tag keys."""
        what, _, arg = text.partition("|")
        if what == "alloff":
            self._release_all()
            return
        if what in ("on", "off"):
            # on|<key>|<kind>|<n>  and  off|<key>
            parts = arg.split("|")
            keyid = parts[0][:16]
            if what == "off":
                self._release(keyid)
                return
            if len(parts) != 3 or not parts[2].isdigit() or not 1 <= int(parts[2]) <= max(self.ntags, 14):
                return
            if parts[1] in ("note", "chord", "degree", "degreechord"):
                self._hold(keyid, parts[1], int(parts[2]))
            return
        if what == "transpose":
            try:
                step = int(arg)
            except ValueError:
                return
            if abs(step) > 12:
                return
            self.synth.transpose = max(-24, min(24, self.synth.transpose + step))
            self._play(1, NOTE_LEN)
            return
        if not arg.isdigit() or not 1 <= int(arg) <= max(self.ntags, 14):
            return
        tag = int(arg)
        if what == "degree":            # a white key beyond the tags (0 is the tenth)
            self._play(white(tag), NOTE_LEN)
            return
        if what == "degreechord":
            for r in (white(tag), white(tag + 2), white(tag + 4)):
                self._play(r, CHORD_LEN)
            return
        if tag not in RATIOS:
            return
        if what == "note":
            self._play(RATIOS[tag], NOTE_LEN)
        elif what == "chord":
            for r in degree_chord(tag):
                self._play(r, CHORD_LEN)

    def line(self, text):
        """Consume one `<monitor>|v=..|o=..|u=..|f=..` body (prefix already stripped)."""
        fields = text.split("|")
        data = {}
        for f in fields[1:]:
            if "=" in f:
                key, val = f.split("=", 1)
                data[key] = val

        def ints(s, split_counts=False):
            out = set()
            for part in s.split(","):
                if not part:
                    continue
                if split_counts:
                    part = part.split(":", 1)[0]
                if part.isdigit():
                    n = int(part)
                    if 1 <= n <= 999:
                        out.add(n)
            return out

        viewed = ints(data.get("v", ""))
        occupied = ints(data.get("o", ""), split_counts=True)
        urgent = ints(data.get("u", ""))
        with self.lock:
            self.occupied = occupied
            self.view_changed(viewed, occupied)
            self.urgency_changed(urgent)


# ---------------------------------------------------------------------------------------
# Socket follower
# ---------------------------------------------------------------------------------------

PREFIX = "custom>>hyprdwmland>>"
JAM_PREFIX = "custom>>hyprtonation>>"   # jam mode: note|N, chord|N (see hypr/jam.lua)
MAX_LINE = 4096


def socket_path():
    run = os.environ.get("XDG_RUNTIME_DIR")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not run or not sig:
        raise SystemExit("XDG_RUNTIME_DIR and HYPRLAND_INSTANCE_SIGNATURE must be set")
    return os.path.join(run, "hypr", sig, ".socket2.sock")


def follow(lines_out, monitor, jam_out=None):
    """Yield protocol bodies for `monitor` from the event socket, reconnecting on loss."""
    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.connect(socket_path())
                # now that we are listening, ask hypr-dwm-land for the current state
                subprocess.Popen(["/usr/bin/hyprctl", "eval", "hyprdwmland.emit()"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                buf = b""
                while True:
                    chunk = s.recv(65536)
                    if not chunk:
                        break
                    buf += chunk
                    if len(buf) > MAX_LINE * 8:
                        buf = buf[-MAX_LINE:]
                    while b"\n" in buf:
                        raw, buf = buf.split(b"\n", 1)
                        if len(raw) > MAX_LINE:
                            continue
                        line = raw.decode("utf-8", "replace")
                        if line.startswith(PREFIX):
                            body = line[len(PREFIX):]
                            if body.split("|", 1)[0] == monitor:
                                lines_out(body)
                        elif jam_out and line.startswith(JAM_PREFIX):
                            jam_out(line[len(JAM_PREFIX):])
        except (OSError, ConnectionError):
            time.sleep(1.0)


def pidfile_path():
    run = os.environ.get("XDG_RUNTIME_DIR")
    if not run:
        raise SystemExit("XDG_RUNTIME_DIR is not set")
    d = os.path.join(run, "just-hyprtonation")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return os.path.join(d, "pid")


def write_pidfile():
    path = pidfile_path()
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(str(os.getpid()))
    return path


def control_path():
    return os.path.join(os.path.dirname(pidfile_path()), "instrument")


def write_control(name):
    os.makedirs(os.path.dirname(control_path()), mode=0o700, exist_ok=True)
    with open(control_path(), "w") as f:
        f.write(name)


def saved_path():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "just-hyprtonation", "instrument")


def save_instrument(name):
    """Remember the choice across relaunches."""
    try:
        os.makedirs(os.path.dirname(saved_path()), mode=0o700, exist_ok=True)
        with open(saved_path(), "w") as f:
            f.write(name)
    except OSError:
        pass


def saved_setting(name):
    try:
        with open(os.path.join(os.path.dirname(saved_path()), name)) as f:
            return f.read().strip()
    except OSError:
        return ""


def save_setting(name, value):
    try:
        os.makedirs(os.path.dirname(saved_path()), mode=0o700, exist_ok=True)
        with open(os.path.join(os.path.dirname(saved_path()), name), "w") as f:
            f.write(value)
    except OSError:
        pass


def saved_instrument():
    try:
        with open(saved_path()) as f:
            name = f.read().strip()
    except OSError:
        return None
    return name if name in INSTRUMENTS else None


def current_instrument():
    try:
        with open(control_path()) as f:
            return f.read().strip()
    except OSError:
        return ""


def pick_instrument():
    """Menu of instruments via omarchy-menu-select (the Omarchy shell); returns the
    choice, or "" if dismissed."""
    names = sorted(INSTRUMENTS)
    cur = current_instrument()
    rows = [("\u2713\t" + n) if n == cur else n for n in names]
    try:
        out = subprocess.run(["omarchy-menu-select", "Instrument", *rows],
                             capture_output=True, text=True, timeout=120).stdout.strip()
    except FileNotFoundError:
        raise SystemExit("omarchy-menu-select not found; pass the name: instrument NAME")
    except subprocess.TimeoutExpired:
        return ""
    return out if out in INSTRUMENTS else ""


def signal_running(sig):
    """Send `sig` to the instance named by the pidfile, after checking it is ours."""
    path = pidfile_path()
    try:
        with open(path) as f:
            pid = int(f.read().strip() or "0")
    except (OSError, ValueError):
        raise SystemExit("no running instance (no pidfile)")
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            cmd = f.read()
    except OSError:
        raise SystemExit("no running instance (stale pidfile)")
    if b"just-hyprtonation" not in cmd:
        raise SystemExit("pidfile does not point at just-hyprtonation; not signalling")
    os.kill(pid, sig)


def default_monitor():
    try:
        out = subprocess.run(["/usr/bin/hyprctl", "monitors", "-j"], capture_output=True,
                             text=True, timeout=3).stdout
        import json
        mons = json.loads(out)
        return mons[0]["name"] if mons else ""
    except Exception:
        return ""


def main():
    if len(sys.argv) == 2 and sys.argv[1] in ("mute", "stop"):
        signal_running(signal.SIGUSR1 if sys.argv[1] == "mute" else signal.SIGTERM)
        return
    if len(sys.argv) == 3 and sys.argv[1] == "layout":
        if sys.argv[2] not in LAYOUTS:
            raise SystemExit("layouts: " + " ".join(sorted(LAYOUTS)))
        save_setting("layout", sys.argv[2])
        try:
            signal_running(signal.SIGUSR2)
        except SystemExit:
            pass                    # saved for the next start
        return
    if len(sys.argv) == 2 and sys.argv[1] == "status":
        cur = current_instrument()
        if not cur or not os.path.exists(pidfile_path()):
            raise SystemExit(1)
        print(cur)
        return
    if len(sys.argv) in (2, 3) and sys.argv[1] in ("instrument", "pick"):
        names = sorted(INSTRUMENTS)
        want = sys.argv[2] if len(sys.argv) == 3 else ""
        if sys.argv[1] == "pick" or want == "":
            want = pick_instrument()
            if not want:
                return
        elif want in ("next", "prev"):
            cur = current_instrument()
            i = names.index(cur) if cur in names else -1
            want = names[(i + (1 if want == "next" else -1)) % len(names)]
        elif want not in INSTRUMENTS:
            raise SystemExit("instruments: " + " ".join(names) + " | next | prev")
        write_control(want)
        signal_running(signal.SIGUSR2)
        save_instrument(want)
        return
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--monitor", default=None, help="monitor name whose tags to voice (default: first)")
    ap.add_argument("--backend", default="fluidsynth", choices=["fluidsynth", "dry"])
    ap.add_argument("--soundfont", default="/usr/share/soundfonts/FluidR3_GM.sf2")
    ap.add_argument("--audio-driver", default="pipewire")
    ap.add_argument("--instrument", default=None, choices=sorted(INSTRUMENTS),
                    help="default: the last one picked, else vibraphone")
    ap.add_argument("--tonic", type=int, default=None, help="MIDI note of tag 1 (default: the instrument's)")
    ap.add_argument("--ntags", type=int, default=21)
    ap.add_argument("--layout", default=None, choices=sorted(LAYOUTS),
                    help="F-key tuning: piano (the sharps in order) or laptop (F<n> between white n and n+1); "
                         "default: the last one given, else piano")
    ap.add_argument("--muted", action="store_true", help="start muted; SIGUSR1 toggles")
    ap.add_argument("--stdin", action="store_true", help="read protocol bodies from stdin (tests)")
    args = ap.parse_args()
    if args.layout is None:
        args.layout = saved_setting("layout") if saved_setting("layout") in LAYOUTS else "piano"
    elif not args.stdin:
        save_setting("layout", args.layout)
    set_layout(args.layout)
    if args.instrument is None:
        args.instrument = saved_instrument() or "vibraphone"
    elif not args.stdin:
        save_instrument(args.instrument)

    tonic = args.tonic if args.tonic is not None else INSTRUMENTS[args.instrument]["tonic"]
    if args.backend == "fluidsynth":
        if not os.path.isfile(args.soundfont):
            raise SystemExit(f"SoundFont not found: {args.soundfont}")
        synth = FluidSynth(tonic, soundfont=args.soundfont, audio_driver=args.audio_driver,
                           instrument=args.instrument, fixed_tonic=args.tonic is not None)
    else:
        synth = Dry(tonic)

    player = Player(synth, ntags=args.ntags)
    player.muted = args.muted

    def toggle_mute(*_):
        player.muted = not player.muted
        print("muted" if player.muted else "unmuted", file=sys.stderr, flush=True)

    def change_instrument(*_):
        layout = saved_setting("layout")
        if layout in LAYOUTS and layout != args.layout:
            args.layout = layout
            set_layout(layout)
            print(f"layout {layout}", file=sys.stderr, flush=True)
        try:
            with open(control_path()) as f:
                name = f.read().strip()
        except OSError:
            return
        if name in INSTRUMENTS and name != synth.instrument:
            synth.set_instrument(name)
            print(f"instrument {name}", file=sys.stderr, flush=True)

    signal.signal(signal.SIGUSR1, toggle_mute)
    signal.signal(signal.SIGUSR2, change_instrument)
    signal.signal(signal.SIGTERM, lambda *_: (synth.close(), sys.exit(0)))
    pidfile = None if args.stdin else write_pidfile()
    if pidfile:
        write_control(args.instrument)

    try:
        if args.stdin:
            for raw in sys.stdin:
                raw = raw.rstrip("\n")
                if raw.startswith(PREFIX):
                    raw = raw[len(PREFIX):]
                if raw:
                    player.line(raw)
            time.sleep(3)  # let timers finish
        else:
            monitor = args.monitor or default_monitor()
            if not monitor:
                raise SystemExit("could not determine a monitor; pass --monitor")
            follow(player.line, monitor, player.jam)
    finally:
        synth.close()
        if pidfile:
            try:
                os.remove(pidfile)
            except OSError:
                pass


if __name__ == "__main__":
    main()
